# API Keys for LLM reranking experiments
# Copy this file to .env and fill in your keys.
# The rebuttal experiments require at least one of the providers below.
# Groq has a free tier (groq.com) sufficient to reproduce the Groq model results.

# OpenAI (used for gpt-4o-mini experiments)
OPENAI_API_KEY=sk-your-openai-key-here

# Groq — free tier available at groq.com (llama-3.3-70b, qwen3-32b)
GROQ_API_KEY=gsk_your-groq-key-here

# DeepSeek official API — platform.deepseek.com (deepseek-chat = DeepSeek-V3)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Moonshot/Kimi official API — platform.moonshot.cn (kimi-k2-turbo-preview)
KIMI_API_KEY=sk-your-kimi-key-here

# Optional legacy keys (not needed for rebuttal experiments)
FIREWORKAI_API_KEY=your-fireworks-key-here
WANDB_API_KEY=your-wandb-key-here
